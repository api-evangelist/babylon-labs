        {
          "id": "5213c178-c8b5-484e-bacf-4d7c9b471a3a",
          "name": "Get stakers' public keys",
          "request": {
            "name": "Get stakers' public keys",
            "description": {
              "content": "Retrieves public keys for the given BTC addresses. This endpoint\nonly returns public keys for addresses that have associated delegations in\nthe system. If an address has no associated delegation, it will not be\nincluded in the response. Supports both Taproot and Native Segwit addresses.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "staker",
                "pubkey-lookup"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "address",
                  "value": "<string>",
                  "description": "(Required) List of BTC addresses to look up (up to 10), currently only supports Taproot and Native Segwit addresses"
                },
                {
                  "disabled": false,
                  "key": "address",
                  "value": "<string>",
                  "description": "(Required) List of BTC addresses to look up (up to 10), currently only supports Taproot and Native Segwit addresses"
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
